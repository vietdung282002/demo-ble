  "cards": [
    {
      "dot": "cyan",
      "title": "Chứng minh ở gần",
      "items": [
        "Chooser chỉ liệt kê thiết bị đang quảng bá service 0xFFF3",
        "EID chỉ giải mã được bằng khóa dẫn xuất từ qrSecret của QR hiện tại",
        "psk = HKDF(qrSecret, advert plaintext) nên chỉ ai nhận được advert mới bắt tay được"
      ]
    },
    {
      "dot": "rose",
      "title": "Thất bại và timeout",
