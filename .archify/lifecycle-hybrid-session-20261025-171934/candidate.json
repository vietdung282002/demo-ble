  "cards": [
    {
      "dot": "cyan",
      "title": "Luồng chính",
      "items": [
        "HybridSession được tạo khi quét QR hợp lệ và bắt đầu ở ADVERTISING",
        "kết nối = central GATT kết nối; msg1 = HANDSHAKE_1 qua kiểm psk; challenge = nhận DATA đã mã hóa",
        "Mỗi phiên chỉ phục vụ một QR và một central GATT",
        "DONE là kết thúc cho cả hai kết quả Approve và Reject"
      ]
    },
    {
      "dot": "rose",
      "title": "Vào ERROR",
      "items": [
        "fail() bỏ qua nếu đã DONE hoặc ERROR",
        "Timeout theo TTL còn lại của QR, cancel() và lỗi giao thức đều gọi fail()",
        "shutdown() hủy timeout, dừng peripheral và tắt worker thread"
      ]
    },
    {
      "dot": "amber",
      "title": "Luồng xử lý",
      "items": [
        "Callback BLE đến trên binder thread và được chuyển sang một worker thread",
